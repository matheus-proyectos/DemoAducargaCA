# ─────────────────────────────────────────────────────────────
# ADUCARGA — variables de entorno
# Sin las variables de Supabase la app corre en MODO DEMO
# (datos locales en .data/db.json, con clientes y paquetes ficticios).
# Con las tres de Supabase definidas, usa Supabase automáticamente.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (OBLIGATORIA en producción).
# Detrás de un proxy inverso (Traefik/EasyPanel) las redirecciones
# se construyen con esta variable, nunca con request.url.
# Formato: https://aducarga.com  (sin barra final)
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sesión: cadena aleatoria de 32+ caracteres (openssl rand -hex 32)
SESSION_SECRET=

# Cron: secreto que protege los endpoints de tareas programadas.
# El servicio de cron lo envía como Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Opcional — notificaciones externas (email / WhatsApp) vía webhook (p. ej. n8n, Make).
# Cada cambio de estado notificable se envía como JSON firmado (cabecera X-Aducarga-Signature).
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# Opcional — carpeta de datos del modo demo (por defecto ./.data)
DATA_DIR=
