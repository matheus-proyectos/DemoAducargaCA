# Variables para producción (EasyPanel / VPS)
# Copiar a .env en el VPS

# URL pública del sitio (OBLIGATORIA en producción) — sin barra final
NEXT_PUBLIC_SITE_URL=https://aducarga.com

# Cron: secreto que protege los endpoints de tareas programadas
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sesión
SESSION_SECRET=

# Opcionales
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
DATA_DIR=.data
